pipeline {
    agent any

    environment {
        IMAGE_NAME = "market-supplier-frontend"
        CONTAINER_NAME = "market-supplier-frontend"
        GIT_CREDENTIALS_ID = "0b91579b-700e-4d1d-a0cf-0d55386b088f"
        GIT_REPO = "git@github.com:serkan-can-eyvaz/Market-Supplier-System.git"
    }

    stages {
        stage('Checkout') {
            steps {
                sshagent (credentials: ["${GIT_CREDENTIALS_ID}"]) {
                    git branch: 'deploy-branch', url: "${GIT_REPO}"
                }
            }
        }

        stage('Build Frontend') {
            steps {
                sh '''
                    npm install
                    npm run build
                '''
            }
        }

        stage('Check Build Output') {
            steps {
                dir('market-supplier-web') {
                    sh 'ls -la build'
                }
            }
        }

        stage('Copy Build to Nginx Directory') {
            steps {
                sh '''
                    if [ ! -d "/var/lib/jenkins/workspace/market-supplier-web/market-supplier-web-build/market-supplier-web" ]; then
                        mkdir -p /var/lib/jenkins/workspace/market-supplier-web/market-supplier-web-build/market-supplier-web
                    fi
                    cp -r build/* /var/lib/jenkins/workspace/market-supplier-web/market-supplier-web-build/market-supplier-web/
                '''
            }
        }
            }

    post {
        success {
            echo "✅ market-supplier-web frontend build ve kopyalama tamamlandı!"
            echo "Frontend: http://localhost:80"
        }
        failure {
            echo "❌ market-supplier-web frontend build veya deploy başarısız!"
        }
    }
}