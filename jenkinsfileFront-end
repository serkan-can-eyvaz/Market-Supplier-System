pipeline {
    agent any

    environment {
        IMAGE_NAME = "market-supplier-frontend"
        CONTAINER_NAME = "market-supplier-frontend"
        GIT_CREDENTIALS_ID = "0b91579b-700e-4d1d-a0cf-0d55386b088f"
        GIT_REPO = "git@github.com:serkan-can-eyvaz/Market-Supplier-System.git"
    }

    stages {
        stage('Checkout') {
            steps {
                sshagent (credentials: ["${GIT_CREDENTIALS_ID}"]) {
                    git branch: 'deploy-branch', url: "${GIT_REPO}"
                }
            }
        }

        stage('Debug Workspace Structure') {
            steps {
                sh '''
                    echo "=== Root workspace contents ==="
                    ls -la
                    echo "=== market-supplier-web directory contents ==="
                    ls -la market-supplier-web/
                    echo "=== market-supplier-web/public directory contents ==="
                    ls -la market-supplier-web/public/
                '''
            }
        }

        stage('Build Frontend') {
            steps {
                dir('market-supplier-web') {
                    sh '''
                        npm install
                        npm run build
                    '''
                }
            }
        }

        stage('Check Build Output') {
            steps {
                dir('market-supplier-web') {
                    sh 'ls -la build'
                }
            }
        }

        stage('Copy Build to Nginx Directory') {
            steps {
                dir('market-supplier-web') {
                    sh '''
                        if [ ! -d "/var/lib/jenkins/workspace/market-supplier-web/market-supplier-web-build" ]; then
                            mkdir -p /var/lib/jenkins/workspace/market-supplier-web/market-supplier-web-build
                        fi
                        cp -r build/* /var/lib/jenkins/workspace/market-supplier-web/market-supplier-web-build/
                    '''
                }
            }
        }
            }

    post {
        success {
            echo "✅ market-supplier-web frontend build ve kopyalama tamamlandı!"
            echo "Frontend: http://localhost:80"
        }
        failure {
            echo "❌ market-supplier-web frontend build veya deploy başarısız!"
        }
    }
}