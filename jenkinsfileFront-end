pipeline {
    agent any

    environment {
        IMAGE_NAME = "market-supplier-frontend"
        CONTAINER_NAME = "market-supplier-frontend"
        GIT_CREDENTIALS_ID = "0b91579b-700e-4d1d-a0cf-0d55386b088f"
        GIT_REPO = "git@github.com:serkan-can-eyvaz/Market-Supplier-System.git"
    }

    stages {
        stage('Checkout') {
            steps {
                sshagent (credentials: ["${GIT_CREDENTIALS_ID}"]) {
                    git branch: 'deploy-branch', url: "${GIT_REPO}"
                }
            }
        }

        stage('Build Frontend') {
            steps {
                // Root dizinde build alınır
                sh "npm install"
                sh "npm run build"
            }
        }

        stage('Check Build Output') {
            steps {
                sh 'ls -la build/'
            }
        }

        stage('Copy Build to Nginx Directory') {
            steps {
                sh '''
                    TARGET_DIR="/var/lib/jenkins/workspace/market-supplier-web/market-supplier-web-build"

                    # Hedef klasör yoksa oluştur
                    mkdir -p "$TARGET_DIR"

                    # Eski build dosyalarını sil
                    rm -rf "$TARGET_DIR"/*

                    # Yeni build çıktısını kopyala
                    cp -r build/* "$TARGET_DIR"/
                '''
            }
        }
    }

    post {
        success {
            echo "✅ market-supplier-web frontend build ve kopyalama işlemi tamamlandı!"
            echo "Frontend: http://localhost:80"
        }
        failure {
            echo "❌ market-supplier-web frontend build veya deploy başarısız!"
        }
    }
}